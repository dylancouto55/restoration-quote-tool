{
  "version": 2,
  "name": "restoration-quote-tool",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 10 * * *"
    }
  ]
}
